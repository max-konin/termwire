{
  "preset": "openai",
  "presets": {
    "openai": {
      "orchestrator": {
        "model": "openai/gpt-5.6-sol",
        "skills": ["*"],
        "mcps": ["*", "!context7"],
      },
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high",
        "skills": [
          "simplify",
          "superpowers/systematic-debugging",
          "superpowers/requesting-code-review",
          "superpowers/receiving-code-review",
        ],
        "mcps": [],
      },
      "council": {
        "model": "openai/gpt-5.6-sol",
      },
      "librarian": {
        "model": [
          { "id": "openai/gpt-5.6-luna", "variant": "low" },
        ],
        "skills": [],
        "mcps": ["websearch", "context7", "grep_app"],
      },
      "explorer": {
        "model": [
          { "id": "openai/gpt-5.6-luna", "variant": "low" },
        ],
        "skills": ["codemap"],
        "mcps": [],
      },
      "designer": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
        "skills": ["agent-browser", "a11y"],
        "mcps": [],
      },
      "fixer": {
        "model": "openai/gpt-5.6-terra",
        "variant": "medium",
        "skills": [
          "verify",
          "superpowers/test-driven-development",
          "superpowers/verification-before-completion",
        ],
        "mcps": [],
      },
    },
  },
  "multiplexer": {
    "type": "auto",
    "layout": "main-vertical",
    "main_pane_size": 60,
  },
  "council": {
    "presets": {
      "default": {
        "alpha": {
          "model": "github-copilot/claude-sonnet-4.6",
          "variant": "high",
        },
        "beta": {
          "model": "github-copilot/gemini-3.1-pro-preview",
          "variant": "high",
        },
      },
    },
  },
  "todoContinuation": {
    "maxContinuations": 50,
    "cooldownMs": 3000,
    "autoEnable": false,
    "autoEnableThreshold": 4,
  },
}
