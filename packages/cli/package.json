{
  "name": "@termwire/cli",
  "version": "0.6.0",
  "description": "Creates tmux workspaces where a coding agent and Neovim run side by side, and opens files in the workspace editor.",
  "keywords": [
    "tmux",
    "neovim",
    "nvim",
    "coding-agent",
    "ai-agent",
    "claude-code",
    "opencode",
    "git-worktree",
    "workspace",
    "cli",
    "developer-tools"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "termwire": "dist/bin/termwire.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/max-konin/termwire.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/max-konin/termwire#readme",
  "bugs": {
    "url": "https://github.com/max-konin/termwire/issues"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1",
    "@termwire/nvim": "^0.6.0",
    "@termwire/tmux": "^0.6.0",
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.6"
  }
}
