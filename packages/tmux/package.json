{
  "name": "@termwire/tmux",
  "version": "0.6.0",
  "description": "A thin, typed adapter for tmux 3.2 or newer.",
  "keywords": [
    "tmux",
    "adapter",
    "terminal",
    "session",
    "pane",
    "typescript",
    "cli"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/max-konin/termwire.git",
    "directory": "packages/tmux"
  },
  "homepage": "https://github.com/max-konin/termwire#readme",
  "bugs": {
    "url": "https://github.com/max-konin/termwire/issues"
  }
}
